---
import '../styles/fonts.css'
import '../styles/site.css'

import {Image} from 'astro:assets'

import icon from '../assets/icon.png'
import {contactEmail} from '../site'

interface Props {
    title: string
    description: string
}

const {title, description} = Astro.props
const base = import.meta.env.BASE_URL
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined
---

<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    {canonical && <link rel="canonical" href={canonical}>}
    <link rel="icon" href={`${base}favicon.png`} media="(prefers-color-scheme: light)">
    <link rel="icon" href={`${base}favicon-dark.png`} media="(prefers-color-scheme: dark)">
    <!-- Decided before the first paint, from the same key the guide's theme
         switch writes, so the page and the guide stay on one side. -->
    <script is:inline>
        document.documentElement.dataset.theme = localStorage.getItem('starlight-theme') ||
            (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
    </script>
</head>
<body>

<header class="site-header">
    <div class="wrap header-row">
        <a class="wordmark" href={base}>
            <Image src={icon} alt="" width={32} height={32} />
            <span>Pourquoi Pas?</span>
        </a>
        <nav class="nav">
            <a class="nav-wide" href="#how">Как это работает</a>
            <a class="nav-wide" href="#inbox">Входящие</a>
            <a href={`${base}docs/`}>Руководство</a>
            <a class="nav-wide" href="#price">Цена</a>
            <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Переключить тему">
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"/></svg>
            </button>
        </nav>
    </div>
</header>

<main id="top">
    <slot />
</main>

<footer class="site-footer">
    <div class="wrap footer-grid">
        <div>
            <p class="footer-name">Pourquoi Pas?</p>
            <p class="muted">Доска, на&nbsp;которой работают ИИ-агенты.</p>
        </div>
        <nav class="footer-links">
            <a href={`${base}docs/`}>Руководство</a>
            <a href={`${base}en/docs/`} lang="en">Guide in English</a>
            {contactEmail && <a href={`mailto:${contactEmail}`}>{contactEmail}</a>}
        </nav>
    </div>
    <div class="wrap">
        <p class="copyright">© 2026 Pourquoi Pas?</p>
    </div>
</footer>

<script>
    const root = document.documentElement
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
        root.dataset.theme = next
        localStorage.setItem('starlight-theme', next)
    })
</script>
</body>
</html>
