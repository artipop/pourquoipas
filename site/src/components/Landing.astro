---
import '../styles/fonts.css'
import '../styles/site.css'

import {Image} from 'astro:assets'

import icon from '../assets/icon.png'
import shipDark from '../assets/ship-dark.jpg'
import ship from '../assets/ship.jpg'
import type {LandingStrings} from '../i18n/landing'
import {contactEmail, preorderEndpoint} from '../site'

interface Props {
    t: LandingStrings
}

const {t} = Astro.props
const base = import.meta.env.BASE_URL
const prefix = t.lang === 'en' ? '' : `${t.lang}/`
const home = `${base}${prefix}`
const docs = `${base}${prefix}docs/`
const other = `${base}${t.lang === 'en' ? 'ru/' : ''}`
const languages = [
    {lang: 'en', name: 'English', href: base},
    {lang: 'ru', name: 'Русский', href: `${base}ru/`},
]
const current = languages.find((language) => language.lang === t.lang)!
const preorder = Boolean(preorderEndpoint || contactEmail)
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined
---

<!doctype html>
<html lang={t.lang}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{t.title}</title>
    <meta name="description" content={t.description}>
    <meta property="og:title" content={t.title}>
    <meta property="og:description" content={t.description}>
    <meta property="og:type" content="website">
    {canonical && <link rel="canonical" href={canonical}>}
    <link rel="alternate" hreflang="en" href={base}>
    <link rel="alternate" hreflang="ru" href={`${base}ru/`}>
    <link rel="icon" href={`${base}favicon.png`} media="(prefers-color-scheme: light)">
    <link rel="icon" href={`${base}favicon-dark.png`} media="(prefers-color-scheme: dark)">
    <!-- Decided before the first paint, from the same key the guide's theme
         switch writes, so the page and the guide stay on one side. -->
    <script is:inline>
        document.documentElement.dataset.theme = localStorage.getItem('starlight-theme') ||
            (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
    </script>
</head>
<body>

<header class="site-header">
    <div class="wrap header-row">
        <a class="wordmark" href={home}>
            <Image src={icon} alt="" width={32} height={32} />
            <span>Pourquoi Pas?</span>
        </a>
        <nav class="nav">
            <a class="nav-wide" href="#how">{t.nav.how}</a>
            <a class="nav-wide" href="#inbox">{t.nav.inbox}</a>
            <a href={docs}>{t.nav.docs}</a>
            {/* Hidden with the price section below.
            <a class="nav-wide" href="#price">{t.nav.price}</a>
            */}
            <details class="languages" id="languages">
                <summary aria-label={t.nav.language}>
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="8" cy="8" r="6.5"/><path d="M1.5 8h13M8 1.5c-2.2 2.4-2.2 10.6 0 13M8 1.5c2.2 2.4 2.2 10.6 0 13"/></g></svg>
                    <span>{current.name}</span>
                    <svg class="caret" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
                </summary>
                <ul>
                    {languages.map((language) => (
                        <li>
                            <a href={language.href} lang={language.lang} hreflang={language.lang} aria-current={language.lang === t.lang ? 'page' : undefined}>{language.name}</a>
                        </li>
                    ))}
                </ul>
            </details>
            <button class="theme-toggle" type="button" id="theme-toggle" aria-label={t.nav.theme}>
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"/></svg>
            </button>
        </nav>
    </div>
</header>

<main id="top">

<section class="hero">
    <div class="wrap hero-grid">
        <div class="hero-text">
            <p class="label">{t.hero.label}</p>
            <h1 class="title">Pourquoi Pas?</h1>
            <p class="hero-headline">{t.hero.headline}</p>
            <p class="lead" set:html={t.hero.lead} />
            <p set:html={t.hero.text} />
            <p class="actions">
                {preorder && <a class="btn" href="#preorder" set:html={t.hero.preorder} />}
                <a class={preorder ? 'btn btn-ghost' : 'btn'} href="#how">{t.hero.how}</a>
            </p>
        </div>
        <div class="hero-ship">
            <Image class="ship ship-light" src={ship} alt={t.hero.shipAlt} widths={[400, 800]} sizes="(max-width: 52rem) 70vw, 400px" loading="eager" />
            <Image class="ship ship-dark" src={shipDark} alt={t.hero.shipAlt} widths={[400, 800]} sizes="(max-width: 52rem) 70vw, 400px" loading="eager" />
        </div>
    </div>
</section>

<section id="how">
    <div class="wrap">
        <p class="label">{t.how.label}</p>
        <h2>{t.how.title}</h2>

        <!-- A picture of the board drawn in the app's own terms: caps column
             names, cards on the surface, the mustard of an agent asking. -->
        <div class="board" aria-hidden="true">
            {t.how.columns.map((column) => (
                <div class="column">
                    <p class="column-name">{column.name} <span>{column.cards.length}</span></p>
                    {column.cards.map((card) => (
                        <div class:list={['card', {'card-asking': card.asking, 'card-working': card.working}]}>
                            {card.asking && <p class="asking">{card.asking}</p>}
                            <p class="card-title">{card.title}</p>
                            {card.question && <p class="question">{card.question}</p>}
                            {card.answers && <p class="answers"><span>{card.answers[0]}</span><span>{card.answers[1]}</span></p>}
                            {card.comment && <p class="comment">{card.comment}</p>}
                            <p class:list={['card-who', {person: card.person}]}>{card.who}</p>
                        </div>
                    ))}
                </div>
            ))}
        </div>

        <ol class="steps">
            {t.how.steps.map((step) => (
                <li>
                    <h3>{step.title}</h3>
                    <p set:html={step.text} />
                </li>
            ))}
        </ol>
        <p class="muted" set:html={t.how.more.replace('{docs}', docs)} />
    </div>
</section>

<section id="inbox" class="band">
    <div class="wrap">
        <p class="label">{t.inbox.label}</p>
        <h2>{t.inbox.title}</h2>
        <p class="lead" set:html={t.inbox.lead} />
        <div class="tiles">
            {t.inbox.tiles.map((tile) => (
                <div class="tile">
                    <h3>{tile.title}</h3>
                    <p set:html={tile.text} />
                </div>
            ))}
        </div>
        <p class="muted" set:html={t.inbox.moves} />

        <div class="planning">
            <h2 set:html={t.inbox.planTitle} />
            <p set:html={t.inbox.planText} />
        </div>
    </div>
</section>

<section>
    <div class="wrap">
        <p class="label">{t.stepIn.label}</p>
        <div class="pair">
            {t.stepIn.items.map((item) => (
                <div>
                    <h2>{item.title}</h2>
                    <p set:html={item.text} />
                    <p class="muted" set:html={item.muted} />
                </div>
            ))}
        </div>
    </div>
</section>

<section class="facts">
    <div class="wrap">
        <p class="label">{t.facts.label}</p>
        <h2 set:html={t.facts.title} />
        <dl class="rows">
            {t.facts.rows.map((row) => (
                <div>
                    <dt set:html={row.title} />
                    <dd set:html={row.text} />
                </div>
            ))}
        </dl>
    </div>
</section>

{/* Hidden until the subscription has a price.
<section id="price" class="band">
    <div class="wrap price">
        <div>
            <p class="label">{t.price.label}</p>
            <p class="badge">{t.price.badge}</p>
            <h2 set:html={t.price.title} />
            <p set:html={t.price.text} />
            {preorder && <p set:html={t.price.preorder} />}
        </div>

        {preorder && (
            <form
                id="preorder"
                novalidate
                data-endpoint={preorderEndpoint}
                data-email={contactEmail}
                data-strings={JSON.stringify({...t.status, ...t.form})}
            >
                <label class="field">
                    <span>{t.form.email}</span>
                    <input type="email" name="email" required placeholder="you@example.com" autocomplete="email">
                </label>
                <label class="field">
                    <span>{t.form.name}</span>
                    <input type="text" name="name" autocomplete="name">
                </label>
                <label class="field">
                    <span>{t.form.os}</span>
                    <select name="os">
                        <option>macOS</option>
                        <option>Windows</option>
                        <option>Linux</option>
                    </select>
                </label>
                <button class="btn" type="submit" set:html={t.form.submit} />
                <p class="form-status" role="status"></p>
                <p class="muted small" set:html={t.form.note} />
            </form>
        )}
    </div>
</section>
*/}

</main>

<footer class="site-footer">
    <div class="wrap footer-grid">
        <div>
            <p class="footer-name">Pourquoi Pas?</p>
            <p class="muted" set:html={t.footer.tagline} />
        </div>
        <nav class="footer-links">
            <a href={docs}>{t.footer.docs}</a>
            <a href={other} lang={t.lang === 'en' ? 'ru' : 'en'}>{t.footer.other}</a>
            {contactEmail && <a href={`mailto:${contactEmail}`}>{contactEmail}</a>}
        </nav>
    </div>
    <div class="wrap">
        <p class="copyright">© 2026 Pourquoi Pas?</p>
    </div>
</footer>

<script>
    const root = document.documentElement
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
        root.dataset.theme = next
        localStorage.setItem('starlight-theme', next)
    })

    // A details element closes only on its own summary; a menu should also
    // close on a click elsewhere and on Escape.
    const languages = document.getElementById('languages') as HTMLDetailsElement | null
    document.addEventListener('click', (event) => {
        if (languages?.open && !languages.contains(event.target as Node)) languages.open = false
    })
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && languages?.open) {
            languages.open = false
            languages.querySelector('summary')?.focus()
        }
    })

    // With an endpoint the form posts JSON there; without one it opens a mail
    // client with the same fields, so a submission is never silently lost.
    const form = document.getElementById('preorder') as HTMLFormElement | null
    const status = form?.querySelector('.form-status') as HTMLElement | null

    function say(text: string, state = 'ok') {
        if (!status) return
        status.textContent = text
        status.dataset.state = state
    }

    form?.addEventListener('submit', async (event) => {
        event.preventDefault()
        const {endpoint, email} = form.dataset
        const s = JSON.parse(form.dataset.strings ?? '{}') as Record<string, string>
        const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>
        if (!data.email?.includes('@')) {
            say(s.badEmail, 'error')
            return
        }

        if (!endpoint) {
            const body = [`${s.bodyEmail}: ${data.email}`, `${s.bodyName}: ${data.name || '—'}`, `${s.bodyOs}: ${data.os}`].join('\n')
            window.location.href = `mailto:${email}?subject=${encodeURIComponent(s.subject)}&body=${encodeURIComponent(body)}`
            say(s.mailOpened)
            return
        }

        say(s.sending)
        try {
            const response = await fetch(endpoint, {
                method: 'POST',
                headers: {'Content-Type': 'application/json', Accept: 'application/json'},
                body: JSON.stringify(data),
            })
            if (!response.ok) throw new Error(String(response.status))
            form.reset()
            say(s.sent)
        } catch {
            say(email ? s.failedTo.replace('{email}', email) : s.failed, 'error')
        }
    })
</script>
</body>
</html>
