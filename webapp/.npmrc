# Fail loudly when the toolchain doesn't match `engines` in package.json instead of
# silently resolving (and rewriting package-lock.json) on a different npm.
engine-strict=true

# The Solid 2 prereleases outran the peer ranges of what is built on them:
# `@dnd-kit/solid` still asks for solid-js 1 (it runs on webapp/solid1/), and
# `@solidjs/vite-plugin` next asks for a jest-dom this tree has outgrown. The
# lockfile is resolved without those checks, so `npm ci` has to be too — here,
# where CI and a fresh checkout both read it. Revisit when dnd-kit ships Solid 2.
legacy-peer-deps=true

# Which dependencies may run install scripts is declared in package.json's
# `allowScripts`, not here: npm ignores this file's allow-scripts entirely once
# that field exists. Maintain it with `npm approve-scripts` / `npm deny-scripts`.
