          Filter
        </span>
        
      </button>
    </div>
    <div
      aria-label="menuwrapper"
      class="MenuWrapper"
      role="button"
    >
      <button
        class="Button active"
        type="button"
      >
        
        <span>
          Sort
        </span>
        
      </button>
      
    </div>
    <div
      class="board-search-field"
    >
      <i
        class="CompassIcon icon-magnify board-search-icon"
      />
      <input
        class="Editable "
        placeholder="Search cards"
        title=""
      />
    </div>
    <div
      class="ModalWrapper"
    >
      <div
        aria-label="View header menu"
        class="MenuWrapper"
        role="button"
      >
        <button
          class="IconButton"
          type="button"
        >
          <i
            class="CompassIcon icon-dots-horizontal OptionsIcon"
          />
        </button>
        
