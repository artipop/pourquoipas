<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleExecutable</key>
		<string>pourquoipas</string>
		<key>CFBundleGetInfoString</key>
		<string>Boards with coding agents</string>
		<key>CFBundleIconFile</key>
		<string>icons</string>
		<key>CFBundleIconName</key>
		<string>appicon</string>
		<key>CFBundleIdentifier</key>
		<string>io.deffun.pourquoipas</string>
		<key>CFBundleName</key>
		<string>Pourquoi Pas?</string>
		<!-- Finder and the Dock show the name from <lang>.lproj/InfoPlist.strings,
		     but only while the bundle's file name equals this unlocalized one.
		     So the file stays ASCII (pourquoipas.app) and people still read
		     the name with its question mark. -->
		<key>CFBundleDisplayName</key>
		<string>pourquoipas</string>
		<key>LSHasLocalizedDisplayName</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>en</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>1.0.0</string>
		<key>CFBundleVersion</key>
		<string>1.0.0</string>
		<key>LSMinimumSystemVersion</key>
		<string>12.0.0</string>
		<key>NSHighResolutionCapable</key>
		<string>true</string>
		<key>NSHumanReadableCopyright</key>
		<string>Copyright (c) 2026 Artem</string>
		<!-- The scheme the share extension opens: it is a separate, sandboxed
		     process, and opening a URL is the one thing it can do without an
		     address, a token and a developer team behind it. See share.go and
		     docs/sources.md §24. -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLName</key>
				<string>io.deffun.pourquoipas.share</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>pourquoipas</string>
				</array>
			</dict>
		</array>
	</dict>
</plist>