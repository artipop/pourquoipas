# The headless server (`-tags server`, Wails' server mode) in a container: the
# Wails template's Dockerfile, adapted to this tree. Built by
# `wails3 task build:docker`, which builds the page first — frontend/dist is
# embedded by the `frontend` tag, and the image carries no node.
#
# A pure-Go binary (CGO_ENABLED=0; SQLite is modernc's in every build) on a
# distroless/static base.
#
# Configured by the environment at `docker run`:
#   WAILS_SERVER_HOST, WAILS_SERVER_PORT — where the front door listens
#     (0.0.0.0:8080 here); SERVER_HOST/SERVER_PORT are the same thing.
#   POURQUOIPAS_DB_TYPE, POURQUOIPAS_DB_DSN — the board's database: sqlite3 (the default,
#     a file under /data), postgres or mysql with that driver's connection
#     string. On the last two the agents and the sources are off for now.
#   /data — the install's own directory: the SQLite file, uploads, settings.
#     Mount a volume there, or every restart is a new install.
#
# The image is the board. Agents run CLIs — claude, codex, git, node — that a
# distroless image has none of, so a server that runs agents needs a
# RUNTIME_IMAGE that carries them.

ARG GO_IMAGE=golang:alpine
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12

# Build stage
FROM ${GO_IMAGE} AS builder
# server,production is the release server; frontend embeds frontend/dist.
# The Taskfile adds the edition's tag (EDITION=lifetime).
ARG TAGS=server,production,frontend

WORKDIR /app

# The module graph first, so an edit to the source does not download it again.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN test -f frontend/dist/index.html || \
    (echo "frontend/dist is not built: use wails3 task build:docker, which builds it first" >&2 && exit 1)

RUN CGO_ENABLED=0 go build -tags ${TAGS} -trimpath -buildvcs=false -ldflags="-s -w" -o server .

# Runtime stage - minimal image
FROM ${RUNTIME_IMAGE}

COPY --from=builder /app/server /server

# The install's directory is under os.UserConfigDir, which on Linux is
# $XDG_CONFIG_HOME (appDataDir in main.go), so this puts all of it in /data.
ENV XDG_CONFIG_HOME=/data
VOLUME /data

EXPOSE 8080

# Bind to all interfaces (required for Docker).
ENV WAILS_SERVER_HOST=0.0.0.0

ENTRYPOINT ["/server"]
