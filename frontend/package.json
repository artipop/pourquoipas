{
  "name": "pourquoipas",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --minify false --mode development",
    "deveditor": "vite --open /editor.html",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "updatesnapshot": "vitest run --update",
    "check": "eslint . --quiet --cache && stylelint **/*.scss",
    "fix": "eslint . --quiet --fix --cache && stylelint --fix **/*.scss",
    "i18n-extract": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore \"**/*.d.ts\" \"../**/*.d.ts\" \"**/*.test.{ts,tsx}\" --out-file i18n/tmp.json && formatjs compile i18n/tmp.json --out-file i18n/en.json && node -e \"require('fs').rmSync('i18n/tmp.json', {force: true})\"",
    "i18n-table": "node scripts/i18nTable.mjs export",
    "i18n-table-apply": "node scripts/i18nTable.mjs import",
    "runserver-test": "cd cypress && \"../../bin/pourquoipas-server\"",
    "cypress:ci": "start-server-and-test runserver-test http://localhost:8088 cypress:run",
    "cypress:debug": "start-server-and-test runserver-test http://localhost:8088 cypress:open",
    "cypress:run": "cypress run",
    "cypress:run:chrome": "cypress run --browser chrome",
    "cypress:run:firefox": "cypress run --browser firefox",
    "cypress:run:edge": "cypress run --browser edge",
    "cypress:run:electron": "cypress run --browser electron",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@dnd-kit/collision": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/solid": "^0.5.0",
    "@emoji-mart/data": "^1.2.1",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/fira-sans-condensed": "^5.3.0",
    "@formatjs/intl": "^4.1.18",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@lexical/history": "0.49.0",
    "@lexical/plain-text": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@mattermost/compass-icons": "^0.1.39",
    "@solidjs/router": "^2.0.0-next.17",
    "@solidjs/web": "2.0.0-rc.8",
    "@wailsio/runtime": "3.0.0-beta.34",
    "emoji-mart": "^5.6.0",
    "lexical": "0.49.0",
    "marked": "^4.0.12",
    "nanoevents": "^5.1.13",
    "solid-js": "2.0.0-rc.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@formatjs/cli": "^6.16.15",
    "@formatjs/unplugin": "^1.2.3",
    "@solidjs/testing-library": "^1.0.0-beta.2",
    "@solidjs/vite-plugin": "^3.0.0-next.31",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/cypress": "^10.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/marked": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.5.4",
    "cypress": "^15.19.0",
    "cypress-failed-log": "^2.9.5",
    "cypress-real-events": "^1.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "playwright": "^1.64.1",
    "sass": "^1.102.0",
    "start-server-and-test": "^3.0.11",
    "stylelint": "^17.16.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@solidjs/signals": "2.0.0-rc.8"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "cypress": true,
    "esbuild": false,
    "fsevents": false,
    "unrs-resolver": false
  },
  "browserslist": [
    "safari >= 15",
    "chrome >= 100",
    "firefox >= 100",
    "edge >= 100"
  ]
}
